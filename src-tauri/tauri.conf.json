{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LastWave",
  "version": "2.6.0",
  "identifier": "com.lastwave.lastwave_desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LastWave",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico"
    ],
    "resources": [
      "assets/po_token.html",
      "assets/ejs/yt.solver.core.min.js",
      "assets/ejs/yt.solver.lib.min.js"
    ]
  }
}
